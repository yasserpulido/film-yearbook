# TMDb credentials (https://www.themoviedb.org/settings/api).
# Use the "API Read Access Token" (v4, recommended) or the v3 "API Key".
# Only one of them is required. They are read server-side only.
TMDB_API_TOKEN=
TMDB_API_KEY=

# Optional: language used for TMDb titles and the default poster (default: en-US).
# TMDB_LANGUAGE=en-US
